# ============================================================
# Redwolf Online — Backend Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Port server (Render/Railway akan override ini otomatis)
PORT=3001

# URL frontend yang diizinkan mengakses backend (CORS)
# Lokal     : http://localhost:5173
# Produksi  : https://<nama-project-anda>.vercel.app
FRONTEND_URL=http://localhost:5173
