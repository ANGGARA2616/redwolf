# ============================================================
# Redwolf Online — Frontend Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# URL backend Socket.io server (tanpa trailing slash)
# Lokal : http://localhost:3001
# Produksi: https://<nama-service-anda>.onrender.com   (Render)
#          atau https://<nama-service-anda>.up.railway.app (Railway)
VITE_SERVER_URL=http://localhost:3001
